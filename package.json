{
  "name": "314sign-kiosk",
  "version": "1.0.0",
  "description": "Electron kiosk display app for 314Sign menu system with dual HDMI support",
  "main": "dist/main/main.js",
  "preload": "dist/preload/preload.js",
  "homepage": "./",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "npm run build:renderer && npm run build:main && npm run build:314sign",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.main.json",
    "build:314sign": "npm --prefix packages/314Sign run build",
    "start": "electron dist/main/main.js",
    "start:dev": "npm run build:main && electron dist/main/main.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.314sign.kiosk",
    "productName": "314Sign Kiosk",
    "files": [
      "dist/**/*",
      "packages/314Sign/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
